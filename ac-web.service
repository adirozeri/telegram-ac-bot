[Unit]
Description=AC Web Dashboard (FastAPI, LAN only)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=pi
WorkingDirectory=/home/pi/telegram-ac-bot
ExecStart=/home/pi/telegram-ac-bot/telegram-bot-env/bin/python -m uvicorn web_app:app --host 0.0.0.0 --port 8080
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
